diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 7c14f67..6da735f 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -0,0 +1,4 @@
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#endif
+
@@ -34 +38 @@ static void ksu_umount_mnt(const char *mnt, struct path *path, int flags)
-static void try_umount(const char *mnt, int flags)
+static void try_umount(const char *mnt, bool check_mnt, int flags)
@@ -47,0 +52,9 @@ static void try_umount(const char *mnt, int flags)
+#ifdef CONFIG_KSU_SUSFS
+    if (check_mnt && !susfs_is_mnt_devname_ksu(&path)) {
+        path_put(&path);
+        return;
+    }
+#else
+    (void)check_mnt;
+#endif
+
@@ -50,0 +64,16 @@ static void try_umount(const char *mnt, int flags)
+
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid)
+{
+    const struct cred *saved;
+
+    (void)uid;
+    if (!ksu_cred)
+        return;
+
+    saved = override_creds(ksu_cred);
+    try_umount(mnt, check_mnt, flags);
+    revert_creds(saved);
+}
+#endif
+
@@ -97,0 +127,3 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+    susfs_try_umount(new_uid);
+#endif
@@ -103 +135,2 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
-        try_umount(entry->umountable, entry->flags);
+        try_umount(entry->umountable, false, entry->flags);
+
diff --git a/kernel/include/uapi/supercall.h b/kernel/include/uapi/supercall.h
index 5bf7068..38b9cca 100644
--- a/kernel/include/uapi/supercall.h
+++ b/kernel/include/uapi/supercall.h
@@ -172,0 +173,11 @@ DECLARE(__u32, KSU_IOCTL_GET_SULOG_FD, _IOW('K', 20, struct ksu_get_sulog_fd_cmd));
+/* SUSFS uses a private command namespace over the NCL supercall fd. */
+struct ksu_susfs_cmd {
+    __aligned_u64 arg3;
+    __aligned_u64 arg4;
+    __aligned_u64 arg5;
+    __u32 command;
+    __s32 result;
+};
+
+DECLARE(__u32, KSU_IOCTL_SUSFS, _IOWR('K', 21, struct ksu_susfs_cmd));
+
diff --git a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
index a2e2914..683b581 100644
--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -62,3 +61,0 @@ static int do_report_event(void __user *arg)
-#ifdef CONFIG_KSU_SUSFS
-            susfs_start_sdcard_monitor_fn();
-#endif // #ifdef CONFIG_KSU_SUSFS
@@ -554,0 +552,132 @@ static int do_get_sulog_fd(void __user *arg)
+#ifdef CONFIG_KSU_SUSFS
+static int do_susfs(void __user *arg)
+{
+    struct ksu_susfs_cmd cmd;
+    void __user *arg3;
+    int error = -1;
+
+    if (copy_from_user(&cmd, arg, sizeof(cmd)))
+        return -EFAULT;
+
+    arg3 = (void __user *)(unsigned long)cmd.arg3;
+
+    switch (cmd.command) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    case CMD_SUSFS_ADD_SUS_PATH:
+        error = susfs_add_sus_path(arg3);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    case CMD_SUSFS_ADD_SUS_MOUNT:
+        error = susfs_add_sus_mount(arg3);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+    case CMD_SUSFS_ADD_SUS_KSTAT:
+    case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+        error = susfs_add_sus_kstat(arg3);
+        break;
+    case CMD_SUSFS_UPDATE_SUS_KSTAT:
+        error = susfs_update_sus_kstat(arg3);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+    case CMD_SUSFS_ADD_TRY_UMOUNT:
+        error = susfs_add_try_umount(arg3);
+        break;
+    case CMD_SUSFS_RUN_UMOUNT_FOR_CURRENT_MNT_NS:
+        susfs_run_try_umount_for_current_mnt_ns();
+        error = 0;
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    case CMD_SUSFS_SET_UNAME:
+        error = susfs_set_uname(arg3);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    case CMD_SUSFS_ENABLE_LOG:
+        if (cmd.arg3 > 1) {
+            error = -EINVAL;
+        } else {
+            susfs_set_log(cmd.arg3);
+            error = 0;
+        }
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+        error = susfs_set_cmdline_or_bootconfig(arg3);
+        break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+    case CMD_SUSFS_ADD_OPEN_REDIRECT:
+        error = susfs_add_open_redirect(arg3);
+        break;
+#endif
+    case CMD_SUSFS_SHOW_VERSION:
+        error = copy_to_user(arg3, SUSFS_VERSION,
+                             sizeof(SUSFS_VERSION)) ? -EFAULT : 0;
+        break;
+    case CMD_SUSFS_SHOW_VARIANT:
+        error = copy_to_user(arg3, SUSFS_VARIANT,
+                             sizeof(SUSFS_VARIANT)) ? -EFAULT : 0;
+        break;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES: {
+        u64 enabled_features = 0;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+        enabled_features |= 1ULL << 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+        enabled_features |= 1ULL << 1;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+        enabled_features |= 1ULL << 2;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+        enabled_features |= 1ULL << 3;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+        enabled_features |= 1ULL << 4;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+        enabled_features |= 1ULL << 5;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+        enabled_features |= 1ULL << 6;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+        enabled_features |= 1ULL << 7;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+        enabled_features |= 1ULL << 8;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+        enabled_features |= 1ULL << 9;
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+        enabled_features |= 1ULL << 10;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+        enabled_features |= 1ULL << 11;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+        enabled_features |= 1ULL << 12;
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+        enabled_features |= 1ULL << 14;
+#endif
+        error = copy_to_user(arg3, &enabled_features,
+                             sizeof(enabled_features)) ? -EFAULT : 0;
+        break;
+    }
+    default:
+        error = -1;
+        break;
+    }
+
+    cmd.result = error;
+    return copy_to_user(arg, &cmd, sizeof(cmd)) ? -EFAULT : 0;
+}
+#endif
+
@@ -689,0 +819,8 @@ static const struct ksu_ioctl_cmd_map ksu_ioctl_handlers[] = {
+#ifdef CONFIG_KSU_SUSFS
+    {
+        .cmd = KSU_IOCTL_SUSFS,
+        .name = "SUSFS",
+        .handler = do_susfs,
+        .perm_check = only_root
+    },
+#endif
