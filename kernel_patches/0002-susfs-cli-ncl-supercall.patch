diff --git a/ksu_susfs/jni/main.c b/ksu_susfs/jni/main.c
index 2916c9e..7f84067 100644
--- a/ksu_susfs/jni/main.c
+++ b/ksu_susfs/jni/main.c
@@ -6 +6,3 @@
-#include <sys/prctl.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
@@ -122,0 +125,58 @@ struct st_sus_su {
+#define KSU_INSTALL_MAGIC1 0xDEADBEEF
+#define KSU_INSTALL_MAGIC2 0xCAFEBABE
+
+struct ksu_susfs_cmd {
+	uint64_t arg3;
+	uint64_t arg4;
+	uint64_t arg5;
+	uint32_t command;
+	int32_t result;
+};
+
+#define KSU_IOCTL_SUSFS _IOWR('K', 21, struct ksu_susfs_cmd)
+
+static int ksu_susfs_fd = -1;
+
+static int ncl_susfs_prctl(int option, unsigned long command,
+			   unsigned long arg3, unsigned long arg4,
+			   unsigned long arg5)
+{
+	struct ksu_susfs_cmd request = { 0 };
+	int fd = -1;
+
+	if (option != KERNEL_SU_OPTION) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (ksu_susfs_fd < 0) {
+		long syscall_result = syscall(SYS_reboot, KSU_INSTALL_MAGIC1,
+					      KSU_INSTALL_MAGIC2, 0, &fd);
+		if (fd < 0) {
+			if (syscall_result >= 0)
+				errno = EIO;
+			return -1;
+		}
+		ksu_susfs_fd = fd;
+	}
+
+	request.command = (uint32_t)command;
+	request.arg3 = (uint64_t)arg3;
+	request.arg4 = (uint64_t)arg4;
+	request.arg5 = (uint64_t)arg5;
+	if (ioctl(ksu_susfs_fd, KSU_IOCTL_SUSFS, &request) < 0) {
+		if (arg5)
+			*(int *)arg5 = -1;
+		return -1;
+	}
+
+	if (arg5)
+		*(int *)arg5 = request.result;
+	return 0;
+}
+
+#define prctl(option, command, arg3, arg4, arg5) \
+	ncl_susfs_prctl((option), (unsigned long)(command), \
+			(unsigned long)(arg3), (unsigned long)(arg4), \
+			(unsigned long)(arg5))
+
